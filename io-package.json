  "native": {
    "scriptName": "Theme",
    "variableName": "myMdwTheme",
    "javascriptInstance": "",
    "sentryReport": false,
    "md3Seed": "",
    "md3Font": "",
    "defaultDesignStyle": "legacy",
    "colors": [],
    "defaultcolors": [],
    "colorsDark": [],
    "defaultcolorsDark": [],
    "fonts": [],
    "defaultfonts": [],
    "fontSizes": [],
    "defaultfontSizes": [],
    "dependencies": [
      "basic"
    ]
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "designStyle",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Default design style for widgets without an own style (legacy | material3)",
        "type": "string",
        "read": true,
        "write": true,
        "def": "legacy"
      },
      "native": {}
    },
    {
      "_id": "colors",
      "type": "channel",
      "common": {
        "name": "colors"
      },
      "native": {}
    },
    {
      "_id": "fonts",
      "type": "channel",
      "common": {
        "name": "fonts"
      },
      "native": {}
    },
    {
      "_id": "fontSizes",
      "type": "channel",
      "common": {
        "name": "fontSizes"
      },
      "native": {}
    },
    {
      "_id": "colors.light",
      "type": "channel",
      "common": {
        "name": "light"
      },
      "native": {}
    },
    {
      "_id": "colors.dark",
      "type": "channel",
      "common": {
        "name": "dark"
      },
      "native": {}
    },
    {
      "_id": "colors.darkTheme",
      "type": "state",
      "common": {
        "role": "switch",
        "name": "Switch between light and dark colors",
        "type": "boolean",
        "read": true,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "colors.md3Scheme",
      "type": "state",
      "common": {
        "role": "json",
        "name": "Material 3 color scheme derived from the seed (JSON, written by the admin UI)",
        "type": "string",
        "read": true,
        "write": true,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "fonts.md3Font",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Material 3 font family (optional, inherits from the view when empty)",
        "type": "string",
        "read": true,
        "write": true,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "sentry",
      "type": "state",
      "common": {
        "role": "switch",
        "name": "send Widget error reports",
        "desc": "Sentry - automatic error reporting",
        "type": "boolean",
        "read": true,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "lastchange",
      "type": "state",
      "common": {
        "role": "value",
        "name": "last theme changes",
        "desc": "last theme changes",
        "type": "number",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    }
  ]
